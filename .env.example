# Copy to `.env` and edit. `.env` is gitignored; this template is tracked so
# the variables are discoverable without reading the compose file.
#
#   cp .env.example .env
#
# Nothing here is a real credential. Every value below is a local default, and
# the compose file falls back to the same defaults if a variable is unset.

# --- Dashboard password -------------------------------------------------
# The password you type into the web UI. Its sha256 is what the API compares,
# so changing this invalidates existing sessions.
# CHANGE THIS before exposing the dashboard to anything but localhost.
PASSWORD=test

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_NAME=algorithex_db
POSTGRES_USERNAME=algorithex_user
# CHANGE THIS if the database is reachable from anywhere but this machine.
POSTGRES_PASSWORD=password

# --- Redis --------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Ports --------------------------------------------------------------
APP_PORT=9000
LSP_PORT=9001
MCP_PORT=9002
JUPYTER_PORT=8888

# --- Image --------------------------------------------------------------
# Which image to run. The default is built from source by compose. Point this
# at a published image to deploy without a build context:
#   ALGORITHEX_IMAGE=ghcr.io/<owner>/<repo>:latest
ALGORITHEX_IMAGE=algorithex:latest

# --- Optional features --------------------------------------------------
# Leave blank to use the local license-free mode.
LICENSE_API_TOKEN=
MCP_USAGE_METER=local
MCP_GUEST_DAILY_CREDITS=100000
MCP_FREE_DAILY_CREDITS=100000
MCP_LOG_IN_TERMINAL=true

# Runtime artifacts — never commit these.
# Ignore the directory contents but keep the placeholder files that make the
# tree exist on a fresh clone.
/storage/logs/*
!/storage/logs/.gitkeep
/storage/temp/*
!/storage/temp/.gitkeep

# Docker volume: this is a live PostgreSQL data directory (base/, global/, WAL).
# It holds real candle/trade/session data and contains files over 100 MB, which
# GitHub rejects outright. It is recreated by `docker compose up`.
/docker/postgres-data/
